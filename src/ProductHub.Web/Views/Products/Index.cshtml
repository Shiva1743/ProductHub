@model List<Product>
@{
    ViewData["Title"] = "Products";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Products</h1>
    <a class="btn btn-primary" asp-action="Create">+ New Product</a>
</div>
<div class="container">
@if(!Model.Any())
{
    <div class="alert alert-info">No Data Found</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th class="text-end">Price</th>
                <th class="text-end">Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach(var p in Model)
                {
                    <tr>
                        <td>@p.name</td>
                        <td>@p.category.name</td>
                        <td>@p.price</td>
                        <td>@p.stock</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@p.id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form onsubmit="return confirm(' Are you sure ? You want to delete?? ');"  asp-action="Delete" asp-route-id="@p.id" method="post">
                                <button  class="btn btn-sm btn-outline-primary">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
    </table>
}

</div>