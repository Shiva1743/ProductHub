@model List<Category>
@{
    ViewData["Title"] = "Categories";
    var formtype = ViewBag.FormType.ToString() ?? "Create";
    var categoryData = ViewBag.Category as Category;
}

<h1 class="h3">Categories</h1>

<form asp-action="@(formtype == "Create" ? "Create" : "Edit")" asp-route-id="@(categoryData?.id)" method="post" class="row g-2 mb-4">
    <div class="col-6">
        <input name ="Name" value="@(categoryData?.name ?? "")" class="form-control" placeholder="New category" maxlength="100"  />
        <span class="text-danger">
            @Html.ValidationMessage("name")
        </span>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">@(formtype == "Create" ? "Add" : "Update")</button>
    </div>
</form>
<hr />
<div class="container">
    @if (!Model.Any())
    {
        <div class="alert alert-info">No Data Found</div>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th style="width:50%" >Name</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.name</td>
                        <td class="d-flex gap-3">
                            <a asp-action="Edit" asp-route-page="@ViewBag.CurrentPage" asp-route-id="@c.id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form onsubmit="return confirm(' Are you sure ? You want to delete?? ');" asp-route-page="@ViewBag.CurrentPage" asp-action="Delete" asp-route-id="@c.id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-primary" >Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (ViewBag.TotalPage > 1)
        {
            <nav>
                <ul class="pagination" >
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage - 1)" >
                                Previous
                            </a>
                        </li>
                    }
                    @for (int i = 1; i <= ViewBag.TotalPage; i++ )
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "") ">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(i)">
                                @(i)
                            </a>
                        </li>
                    }
                    @if (ViewBag.CurrentPage < ViewBag.TotalPage)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(ViewBag.CurrentPage + 1)">
                                Next
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>